<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "components/seo.njk" %}
  {% include "components/pageheader.njk" %}
  {% for imp in dynamics.common.head %}
    {% include imp %}
  {% endfor %}
  {% for imp in dynamics.index.head %}
    {% include imp %}
  {% endfor %}
{% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
{% set slotName = "index.head" %}{% include "components/pluginSlot.njk" %}
</head>
<body class="theme-{{ meta.baseTheme }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <!-- 左侧可收起导航 -->
  <div x-data="{ navOpen: true }" class="app-layout" :class="navOpen ? '' : 'nav-collapsed'">
    <button class="nav-toggle-button" @click="navOpen = !navOpen" aria-label="Toggle navigation">
      <i :data-lucide="navOpen ? 'chevron-left' : 'chevron-right'" aria-hidden="true"></i>
    </button>

    <aside class="sidebar sidebar-left" x-show="navOpen" x-transition>
{% set regionName = "navigation" %}
        {% set regionFallback = "components/navigation.njk" %}
        {% include "components/pluginRegion.njk" %}
    </aside>

    <main id="main-content" tabindex="-1" class="content-main">


      <header>
        {% if settings.dgShowInlineTitle === true %}
          <h1>{{ noteTitle }}</h1>
        {% endif %}

        {% if settings.dgShowTags === true and tags %}
          <div class="header-tags">
            {% for tag in tags %}
              {% if tag != 'gardenEntry' and tag != 'note' %}
                <a class="tag">
                  #{{ tag }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
{% set slotName = "index.header" %}{% include "components/pluginSlot.njk" %}
</header>

      {% for imp in dynamics.common.beforeContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.index.beforeContent %}
        {% include imp %}
      {% endfor %}

      {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
{% set slotName = "index.beforeContent" %}{% include "components/pluginSlot.njk" %}
<div class="content">{{ content | hideDataview | taggify | link | safe }}</div>
{% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
{% set slotName = "index.afterContent" %}{% include "components/pluginSlot.njk" %}

      {% for imp in dynamics.common.afterContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.index.afterContent %}
        {% include imp %}
      {% endfor %}

      {% include "components/user/notes/footer/001-comment.njk" ignore missing %}

      {% for imp in dynamics.index.footer %}
        {% include imp %}
      {% endfor %}


    </main>

    {% if settings.dgShowBacklinks === true or settings.dgShowLocalGraph === true or settings.dgShowToc === true or plugins.slots["sidebar.top"] or plugins.slots["sidebar.bottom"] %}
      <aside class="sidebar-right">
        {% include "components/sidebar.njk" %}
      </aside>
    {% endif %}
  </div>

  {% for imp in dynamics.common.footer %}
    {% include imp %}
  {% endfor %}
  {% include "components/lucideIcons.njk" %}
{% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
{% set slotName = "index.footer" %}{% include "components/pluginSlot.njk" %}
<div class="floating-actions floating-bottom-right">{% set slotName = "floating.bottomRight" %}{% include "components/pluginSlot.njk" %}</div>
</body>
</html>
