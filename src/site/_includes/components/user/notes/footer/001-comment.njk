{% if commentConfig.enabled %}
<section id="giscus-container" aria-label="评论" tabindex="-1">
    <script src="https://giscus.app/client.js"
        data-repo="{{ commentConfig.repo | escape }}"
        data-repo-id="{{ commentConfig.repoId | escape }}"
        data-category="{{ commentConfig.category | escape }}"
        data-category-id="{{ commentConfig.categoryId | escape }}"
        data-mapping="{{ commentConfig.mapping | escape }}"
        data-strict="{{ commentConfig.strict | escape }}"
        data-reactions-enabled="{{ commentConfig.reactions | escape }}"
        data-emit-metadata="{{ commentConfig.metadata | escape }}"
        data-input-position="{{ commentConfig.position | escape }}"
        data-theme="{{ commentConfig.theme | escape }}"
        data-lang="{{ commentConfig.language | escape }}"
        data-loading="{{ commentConfig.loading | escape }}"
        crossorigin="anonymous"
        async>
    </script>
</section>
{% endif %}
